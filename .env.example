# Required for the chatbot and for repository import (Claude extracts the model)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude model used for chat and extraction (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: GitHub token for importing private repositories and for higher API
# rate limits (unauthenticated: 60 requests/hour). Fine-grained token with
# read-only "Contents" and "Metadata" permission is enough.
# GITHUB_TOKEN=github_pat_...

# Optional: enables the chatbot's web search
# FIRECRAWL_API_KEY=fc-...

# Login for the app (HTTP Basic auth, one shared credential).
# Required in production: without APP_PASSWORD every request gets a 503.
# In development the app is open when APP_PASSWORD is unset.
APP_USERNAME=admin
APP_PASSWORD=change-me-to-a-long-random-string

# Postgres connection string (Neon; use the pooled host for serverless).
# Use a database that is not shared with another app: tables are created on
# first request. If unset in development, an in-memory database is used.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
